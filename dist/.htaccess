# Redirections 301
RewriteEngine On
RedirectPermanent /prevention/ /traitement-preventif/
RedirectPermanent /dangers/ /chenilles-processionnaires-danger/
RedirectPermanent /chiens/ /chenilles-processionnaires-chien/
RedirectPermanent /chats/ /chenilles-processionnaires-chat/
RedirectPermanent /enfants/ /chenilles-processionnaires-enfant/
RedirectPermanent /destruction-nid/ /destruction-nid-chenilles-processionnaires/
RedirectPermanent /piegeage/ /piegeage-chenilles-processionnaires/
RedirectPermanent /zones-d-intervention/ /departements/

# Page 404
ErrorDocument 404 /404.html

# Cache des ressources versionnees
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
